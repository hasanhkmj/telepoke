# Telegram API Configuration
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_telethon_session_string

# Optional: Session Name (default: telegram_session)
# TELEGRAM_SESSION_NAME=telegram_session

# MCP Server Security
# Required to secure the server endpoints
MCP_API_KEY=your_secure_mcp_key_here

# MCP Base URL (public URL where this server is accessible)
MCP_BASE_URL=https://textdonna.com/telegram
